<resources>
    <!-- Base application theme. -->
    <style name="Theme.SecurityLocker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#2196F3</item>
        <item name="colorPrimaryVariant">#2196F3</item>
        <item name="colorOnPrimary">#2196F3</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#2196F3</item>
        <item name="colorSecondaryVariant">#2196F3</item>
        <item name="colorOnSecondary">#2196F3</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#2196F3</item>
        <item name="android:windowBackground">@color/white</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Transparent" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="UnlockTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="radius_image_add_memory">
        <item name="cornerSize">15dp</item>
    </style>

    <style name="Button" parent="@android:style/Widget.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingBottom">@dimen/dimen_x1x</item>
        <item name="android:paddingTop">@dimen/dimen_x1x</item>
        <item name="android:paddingLeft">@dimen/dimen_2x</item>
        <item name="android:paddingRight">@dimen/dimen_2x</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/opensan</item>
    </style>

    <style name="rounded_corner">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RatingBar" parent="Theme.SecurityLocker">
        <item name="colorControlActivated">#FFCD3E</item>
    </style>

    <style name="PositiveButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="rippleColor">?android:colorControlHighlight</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">180dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">0dp</item>
        <item name="iconTint">@null</item>
        <item name="cornerFamily">rounded</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">#03A9F4</item>
    </style>

</resources>